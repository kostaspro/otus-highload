{
  "id": null,
  "uid": "dialog-dashboard",
  "title": "Dialog Dashboard",
  "timezone": "UTC",
  "schemaVersion": 16,
  "version": 3,
  "panels": [
    {
      "type": "graph",
      "title": "Message added Total (Rate)",
      "targets": [
        {
          "expr": "sum(rate(message_added_Messages_total[1m])) by (to_user_id)",
          "legendFormat": "{{to_user_id}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "lines": true,
      "legend": {
        "show": true,
        "alignAsTable": true,
        "rightSide": true
      },
      "tooltip": {
        "shared": true
      }
    },
	    {
      "type": "graph",
      "title": "Message error Total (Rate)",
      "targets": [
        {
          "expr": "sum(rate(message_error_Messages_total[1m])) by (user_id)",
          "legendFormat": "{{user_id}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "lines": true,
      "legend": {
        "show": true,
        "alignAsTable": true,
        "rightSide": true
      },
      "tooltip": {
        "shared": true
      }
    },
    {
      "type": "graph",
      "title": "Message Duration (Percentiles)",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(users_message_duration_Messages_bucket[5m])) by (le))",
          "legendFormat": "50th percentile",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.90, sum(rate(users_message_duration_Messages_bucket[5m])) by (le))",
          "legendFormat": "90th percentile",
          "refId": "C"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(users_message_duration_Messages_bucket[5m])) by (le))",
          "legendFormat": "99th percentile",
          "refId": "D"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 10
      },
      "lines": true,
      "legend": {
        "show": true,
        "alignAsTable": true,
        "rightSide": true
      },
      "tooltip": {
        "shared": true
      },
      "xaxis": {
        "mode": "time"
      },
      "yaxis": {
        "label": "Duration (seconds)"
      }
    }
  ]
}
